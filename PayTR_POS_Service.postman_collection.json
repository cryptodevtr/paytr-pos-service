							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 1000,\n    \"installment\": 3,\n    \"currency\": \"TRY\",\n    \"card_type\": \"credit\",\n    \"card_brand\": \"visa\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/pos/select",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"pos",
								"select"
							]
						},
						"description": "En uygun POS'u seçer - Kredi kartı, TRY, 3 taksit"
